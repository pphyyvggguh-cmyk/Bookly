# GEMINI_API_KEY: Required if server-side AI features are enabled.
# AI Studio injects runtime secrets automatically.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

